# Betriebsart „Hosting-Abo" (SaaS) – Vorlage.
#
#   cp .env.saas.example .env
#   docker compose -f docker-compose.yml -f docker-compose.saas.yml up -d
#
# ACHTUNG: Diese Konfiguration allein macht den Stack NICHT startfähig für
# zahlende Kunden. Offen sind weiterhin Control Plane, Objektspeicher,
# Offsite-Backup und vor allem der nie durchgeführte Multiuser-Test.
# Siehe SoloOffice-Betriebsmodi-Technik.md, Abschnitt 6.

# --- Pflicht, sonst startet der Stack nicht ---------------------------------
# Beide mit `openssl rand -hex 32` erzeugen. Der ENCRYPTION_KEY verschlüsselt
# die SMTP-Zugangsdaten in der Datenbank; geht er verloren, sind sie unlesbar.
POSTGRES_PASSWORD=
ENCRYPTION_KEY=

# Echte öffentliche Adresse der Anwendung. Ohne korrekten Wert scheitert die
# Anmeldung an der CORS-Prüfung.
CORS_ORIGIN=https://app.solooffice.de

# --- Betrieb ----------------------------------------------------------------
COMPOSE_PROJECT_NAME=solooffice-saas
INSTANCE_NAME=saas

# Nur an Loopback gebunden; davor gehört der Reverse-Proxy mit TLS.
FRONTEND_PORT=8080

# Anzahl der Proxy-Schichten vor der Anwendung. Falsch gesetzt bedeutet, dass
# die Anmeldedrosselung am falschen Schlüssel greift.
TRUST_PROXY=1

# Offene Registrierung gehört in den Control Plane, nicht in die Fachanwendung.
REGISTRATION_MODE=invite-only

# --- Speichergrenzen (CX33: 4 vCPU, 8 GB) -----------------------------------
BACKEND_MEMORY_LIMIT=1g
DB_MEMORY_LIMIT=1g

# --- E-Mail -----------------------------------------------------------------
# Ohne SMTP funktionieren Einladungen, Passwort-Zurücksetzung und die
# E-Mail-Bestätigung nicht – alle drei sind im SaaS-Betrieb Pflicht.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=SoloOffice
