# Betriebsart „Demo" – Vorlage. Kopieren nach .env (oder per --env-file laden).
#
#   cp .env.demo.example .env.demo
#   docker compose --env-file .env.demo -f docker-compose.demo.yml up -d --build
#
# Die Demo braucht KEINE Datenbank, KEIN Backend und KEINE Secrets. Sie hält
# ihren gesamten Zustand im localStorage des Browsers. Fällt der Container aus,
# gehen keine Daten verloren.

# Port, auf den der Reverse-Proxy zeigt. Der Container bindet nur an 127.0.0.1.
DEMO_PORT=8081

# Erscheint in der Demo und verlinkt den Quelltext der laufenden Fassung.
# AGPL § 13 verlangt das bei einem öffentlich erreichbaren Netzwerkdienst.
# Im CI-Deploy mit dem echten Commit befüllen: VITE_COMMIT_SHA=${GITHUB_SHA}
VITE_COMMIT_SHA=unknown
VITE_APP_VERSION=dev
# Die Demo bleibt ohne Backend und sendet daher standardmäßig keine Telemetrie.
VITE_TELEMETRY_ENABLED=false

# Öffentliche Rechtstexte (optional; ohne Angaben gelten die SoloOffice-URLs).
VITE_AGB_URL=https://solooffice.de/agb
VITE_AVV_URL=https://solooffice.de/avv
VITE_DATENSCHUTZ_URL=https://solooffice.de/datenschutz
VITE_IMPRESSUM_URL=https://solooffice.de/impressum

# Nur nötig, wenn ein fertiges Image aus der Registry gezogen wird.
# DEMO_IMAGE=ghcr.io/tingeltangelbob/solooffice-demo:main
