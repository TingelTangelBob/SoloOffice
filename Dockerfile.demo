# Build für die öffentliche Demo (demo.solooffice.de).
#
# Warum ein eigener Dockerfile statt eines Schalters am bestehenden Image:
# `VITE_DEMO_MODE` wertet Vite zur BAUZEIT aus (src/services/demoApi.ts). Ein
# Laufzeitschalter ist deshalb nicht möglich – Demo und regulärer Betrieb sind
# zwangsläufig zwei verschiedene Images. Dazu kommt die abweichende
# nginx-Konfiguration, die ohne Backend auskommt.

# Build stage
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

# Vite ersetzt import.meta.env.* beim Bauen; Container-Umgebungsvariablen
# können ein fertiges Bundle nicht mehr verändern.
ARG VITE_DEMO_MODE=true
ARG VITE_API_URL=/api
# Commit der laufenden Fassung. AGPL § 13 verlangt, dass Nutzern eines
# Netzwerkdienstes der Quelltext genau dieser Fassung zugänglich ist.
ARG VITE_COMMIT_SHA=unknown
ARG VITE_APP_VERSION=dev
ENV VITE_DEMO_MODE=${VITE_DEMO_MODE}
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_COMMIT_SHA=${VITE_COMMIT_SHA}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}

COPY . .

# Gleiche Qualitätsstufe wie beim regulären Image: Regressionstests, Lint und
# Typprüfung laufen im Build, damit ein defekter Stand die Demo nicht erreicht.
RUN npm run test:frontend && npm run lint && npm run typecheck && npm run build

# Production stage
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.demo.conf /etc/nginx/conf.d/default.conf

# Nicht als root laufen lassen.
RUN touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /usr/share/nginx/html
USER nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
