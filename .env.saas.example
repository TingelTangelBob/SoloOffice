# Betriebsart „Hosting-Abo" (SaaS) – Vorlage.
#
#   cp .env.saas.example .env.saas
#   ./manage-instances.sh start saas
#   (entspricht: docker compose --env-file .env.saas -f docker-compose.yml \
#        -f docker-compose.saas.yml up -d --build)
#
# ACHTUNG: Diese Konfiguration allein macht den Stack NICHT startfähig für
# zahlende Kunden. Offen sind weiterhin Control Plane, Objektspeicher,
# Offsite-Backup, SMTP-Zustellnachweis und externe Überwachung.
# Siehe docs/saas-control-plane.md und docs/self-hosting.md.

# --- Pflicht, sonst startet der Stack nicht ---------------------------------
# Beide mit `openssl rand -hex 32` erzeugen. Der ENCRYPTION_KEY verschlüsselt
# die SMTP-Zugangsdaten in der Datenbank; geht er verloren, sind sie unlesbar.
POSTGRES_PASSWORD=
ENCRYPTION_KEY=

# Echte öffentliche Adresse der Anwendung. Ohne korrekten Wert scheitert die
# Anmeldung an der CORS-Prüfung.
CORS_ORIGIN=https://app.solooffice.de

# Öffentliche Rechtstexte (optional; ohne Angaben gelten die SoloOffice-URLs).
VITE_AGB_URL=https://solooffice.de/agb
VITE_AVV_URL=https://solooffice.de/avv
VITE_DATENSCHUTZ_URL=https://solooffice.de/datenschutz
VITE_IMPRESSUM_URL=https://solooffice.de/impressum

# --- Optionale Telemetrie ---------------------------------------------------
# Standardmäßig aus. Aktivierung nur nach bewusster Freigabe und mit einem
# Control-Plane-Secret (niemals als VITE_*-Variable eintragen).
VITE_TELEMETRY_ENABLED=false
TELEMETRY_ENABLED=false
TELEMETRY_SOURCE=hosted
TELEMETRY_URL=
TELEMETRY_SECRET=
# Für selfhost: sh_<UUID> und der Installationszeitpunkt als getrennte Felder.
TELEMETRY_INSTALLATION_ID=
TELEMETRY_INSTALLED_AT=
TELEMETRY_TIMEOUT_MS=5000

# --- Betrieb ----------------------------------------------------------------
COMPOSE_PROJECT_NAME=solooffice-saas
INSTANCE_NAME=saas
# manage-instances.sh lädt die hier genannten Overlays zusätzlich zu
# docker-compose.yml (durch Leerzeichen getrennt, nur Dateien im Projektordner).
# Ohne diese Zeile startet `./manage-instances.sh start saas` die Instanz OHNE
# die SaaS-Härtung (Loopback-Port, sichere Cookies, HSTS, Speichergrenzen).
COMPOSE_OVERLAY_FILES=docker-compose.saas.yml

# Nur an Loopback gebunden; davor gehört der Reverse-Proxy mit TLS.
FRONTEND_PORT=8080

# Anzahl der Proxy-Schichten vor der Anwendung. Falsch gesetzt bedeutet, dass
# die Anmeldedrosselung am falschen Schlüssel greift.
TRUST_PROXY=1

# Laufzeitmetriken unter /metrics sind ohne Token gesperrt. Für Monitoring
# einen langen Zufallswert setzen und als Authorization: Bearer <Token> senden.
METRICS_TOKEN=
# Höchstzahl unterschiedlicher Routenschlüssel im Arbeitsspeicher; weitere
# Routen werden unter OTHER zusammengefasst.
METRICS_MAX_PATHS=250
LOG_LEVEL=WARN
# Zeit für laufende HTTP-Anfragen beim kontrollierten Container-Stopp.
SHUTDOWN_TIMEOUT_MS=10000
# Höchstzahl gleichzeitig laufender lokaler OCR-Vorgänge (Standard: 2).
OCR_CONCURRENCY_LIMIT=2
# Zeitlimit je OCR-Hilfsprozess in Millisekunden (Standard: 120000).
OCR_TIMEOUT_MS=120000

# Offene Registrierung gehört in den Control Plane, nicht in die Fachanwendung.
REGISTRATION_MODE=invite-only

# --- Interne Control-Plane-Schnittstelle (AP-4.4) ---------------------------
# Gemeinsames Geheimnis für /internal/control-plane (Workspace anlegen,
# sperren, entsperren). Derselbe Wert steht im Control Plane unter
# SOLOOFFICE_INTERNAL_SECRET. Erzeugen mit `openssl rand -hex 32`.
# Leer oder kürzer als 32 Zeichen: die Endpunkte antworten mit 503
# CONTROL_PLANE_API_NOT_CONFIGURED. Details: docs/control-plane-internal-api.md
CONTROL_PLANE_INTERNAL_SECRET=
# Erlaubtes Zeitfenster der Signatur in Sekunden (Standard 300, Höchstwert 3600).
CONTROL_PLANE_INTERNAL_TIMESTAMP_TOLERANCE_SECONDS=300
# Aufrufe je Minute und Quell-IP auf der internen Schnittstelle.
CONTROL_PLANE_INTERNAL_RATE_LIMIT_MAX=60
# Öffentliche Adresse für den Einladungslink an neue Eigentümer. Ohne Wert
# wird CORS_ORIGIN verwendet.
APP_BASE_URL=https://app.solooffice.de

# --- Speichergrenzen (CX33: 4 vCPU, 8 GB) -----------------------------------
BACKEND_MEMORY_LIMIT=1g
DB_MEMORY_LIMIT=1g

# --- E-Mail -----------------------------------------------------------------
# Ohne SMTP funktionieren Einladungen, Passwort-Zurücksetzung und die
# E-Mail-Bestätigung nicht – alle drei sind im SaaS-Betrieb Pflicht.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=SoloOffice
